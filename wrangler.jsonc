{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hauteur",
  "main": "worker.js",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/ws"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "QUIZ_ROOMS",
        "class_name": "QuizRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["QuizRoom"]
    }
  ]
}
